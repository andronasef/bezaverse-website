---
interface Props {
  eyebrow: string;
  title: string;
  copy?: string;
  align?: 'left' | 'right';
}
const { eyebrow, title, copy, align = 'left' } = Astro.props;
---

<div class:list={['section-intro', `align-${align}`]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 set:html={title}></h2>
  {copy && <p class="intro-copy">{copy}</p>}
</div>
