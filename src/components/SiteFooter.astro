---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer class="site-footer section-dark brand-footer">
  <div class="brand-footer-top" data-reveal>
    <p class="eyebrow">Start a new orbit</p>
    <h2>Build the system<br />behind your next<br /><em>big move.</em></h2>
    <a class="brand-footer-cta" href={`${base}contact`}>Start a conversation <span aria-hidden="true">&nearr;</span></a>
  </div>
  <div class="brand-footer-grid" data-reveal>
    <a class="brand brand-bezaverse brand-light" href={base} aria-label={`${site.name} home`}>
      <svg class="brand-symbol" viewBox="0 0 120 120" aria-hidden="true">
        <path d="M31 18V102M31 18H62a21 21 0 0 1 0 42H31M31 60H68a21 21 0 0 1 0 42H31" />
      </svg>
      <span class="brand-wordmark">ezaverse</span>
    </a>
    <div class="brand-footer-links"><span>Explore</span><a href={base}>Home</a><a href={`${base}#services`}>Services</a><a href={`${base}projects`}>Projects</a><a href={`${base}about`}>About</a></div>
    <div class="brand-footer-links"><span>Connect</span><a href={`mailto:${site.email}`}>{site.email}</a><a href={`${base}contact`}>Start a project</a><a href="https://www.linkedin.com" rel="noreferrer">LinkedIn</a><a href="https://www.instagram.com" rel="noreferrer">Instagram</a></div>
  </div>
  <div class="brand-footer-bottom"><span>{site.location}</span><span>&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</span><span>Designed for systems in motion.</span></div>
  <div class="footer-top" data-reveal>
    <p class="eyebrow">Get in touch</p>
    <h2>Let’s make the next<br /><em>good thing.</em></h2>
    <a class="button button-light" href="/contact">Start a conversation <span aria-hidden="true">↗</span></a>
  </div>
  <div class="footer-bottom">
    <div>
      <a class="brand brand-light" href="/">{site.name}</a>
      <p>{site.location}</p>
    </div>
    <div class="footer-links">
      <a href="mailto:{site.email}">{site.email}</a>
      <a href="/projects">Selected work</a>
      <a href="/about">About the studio</a>
    </div>
    <small>© {new Date().getFullYear()} {site.name}. All rights reserved.</small>
  </div>
</footer>
