---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer class="site-footer">
  <div class="footer-cta shell">
    <div><p class="eyebrow">Have something in mind?</p><h2>Let’s make the next<br /><em>good thing.</em></h2></div>
    <a class="button button-light" href={`${base}contact`}>Start a conversation <span aria-hidden="true">↗</span></a>
  </div>
  <div class="footer-grid shell">
    <a class="brand brand-light" href={base} aria-label={`${site.name} home`}>
      <img class="brand-logo-full" src={`${base}assets/brand/bezaverse-logo.svg`} alt={site.name} />
    </a>
    <div class="footer-links"><span data-i18n="footer.explore">Explore</span><a href={base} data-i18n="nav.home">Home</a><a href={`${base}#services`} data-i18n="nav.services">Services</a><a href={`${base}projects`} data-i18n="nav.work">Selected work</a><a href={`${base}about`} data-i18n="nav.studio">The studio</a></div>
    <div class="footer-links"><span data-i18n="footer.connect">Connect</span><a href={`mailto:${site.email}`}>{site.email}</a><a href={`${base}contact`} data-i18n="nav.start">Start a project</a></div>
  </div>
  <div class="footer-bottom shell"><span>{site.location}</span><span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span><span>Digital work with room to grow.</span></div>
</footer>
