---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header class="site-header" data-header>
  <a class="brand brand-bezaverse" href={base} aria-label={`${site.name} home`}>
    <svg class="brand-symbol brand-symbol-compact" viewBox="0 0 120 120" aria-hidden="true">
      <ellipse class="brand-orbit" cx="60" cy="60" rx="56" ry="25" />
      <path d="M31 18V102M31 18H62a21 21 0 0 1 0 42H31M31 60H68a21 21 0 0 1 0 42H31" />
    </svg>
    <span class="brand-wordmark"><b>B</b>ezaverse</span>
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-toggle>
    <span class="sr-only">Toggle navigation</span>
    <span class="menu-label" data-menu-label>Menu</span>
    <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
  </button>
  <nav id="primary-nav" class="primary-nav" data-nav aria-label="Primary navigation">
    <a href={base}>Home</a>
    <a href={`${base}#services`}>Services</a>
    <a href={`${base}projects`}>Work</a>
    <a href={`${base}about`}>About Us</a>
    <a href={`${base}contact`} class="nav-cta">Book a Call <span aria-hidden="true">↗</span></a>
  </nav>
  <nav class="mobile-dock" aria-label="Mobile navigation">
    <a href={base}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1Z" /></svg><span>Home</span></a>
    <a href={`${base}#services`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v11H4zM8 7V4h8v3M8 12h8" /></svg><span>Services</span></a>
    <a class="mobile-dock-action" href={`${base}contact`} aria-label="Start a project"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h12a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3h-5l-4 4v-4H6a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3Z" /></svg></a>
    <a href={`${base}projects`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-8-8M20 4l-7 7M16 4h4v4" /></svg><span>Work</span></a>
    <button class="mobile-dock-more" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-toggle><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" /></svg><span data-menu-label>More</span></button>
  </nav>
</header>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector('[data-nav]');
  const labels = document.querySelectorAll<HTMLElement>('[data-menu-label]');
  const closeMenu = () => {
    toggles.forEach((toggle) => toggle.setAttribute('aria-expanded', 'false'));
    nav?.removeAttribute('data-open');
    document.body.removeAttribute('data-menu-open');
    labels.forEach((label) => label.textContent = label.closest('.mobile-dock') ? 'More' : 'Menu');
  };
  toggles.forEach((toggle) => toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggles.forEach((item) => item.setAttribute('aria-expanded', String(!open)));
    nav?.toggleAttribute('data-open', !open);
    document.body.toggleAttribute('data-menu-open', !open);
    labels.forEach((label) => label.textContent = open ? (label.closest('.mobile-dock') ? 'More' : 'Menu') : 'Close');
  }));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
</script>
