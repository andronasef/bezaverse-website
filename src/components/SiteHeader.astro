---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header class="site-header" data-header>
  <a class="brand" href={base} aria-label={`${site.name} home`}>
    <img class="brand-logo-full brand-logo-dark" src={`${base}assets/brand/bezaverse-logo.svg`} alt={site.name} />
    <img class="brand-logo-full brand-logo-black" src={`${base}assets/brand/bezaverse-logo-black.svg`} alt={site.name} />
  </a>
  <div class="locale-switcher" role="group" data-i18n-aria-label="language.label">
    <button class="locale-switcher-button" type="button" data-locale-switch="ar" aria-label="العربية">
      <span class="locale-switcher-name">العربية</span><span class="locale-switcher-flag" aria-hidden="true"><img src={`${base}assets/flags/eg.svg`} alt="" /></span>
    </button>
  </div>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-toggle><span class="menu-label" data-i18n="nav.menu">Menu</span><span class="menu-icon" aria-hidden="true"><i></i><i></i></span></button>
  <nav id="primary-nav" class="primary-nav" data-nav aria-label="Primary navigation">
    <a href={base} data-i18n="nav.home">Home</a>
    <a href={`${base}#services`} data-i18n="nav.services">Services</a>
    <a href={`${base}projects`} data-i18n="nav.work">Selected work</a>
    <a href={`${base}about`} data-i18n="nav.studio">The studio</a>
    <a href={`${base}contact`} class="nav-cta">Start a project <span aria-hidden="true">↗</span></a>
  </nav>
  <nav class="mobile-dock" aria-label="Mobile navigation">
    <a data-dock-route="home" href={base}><i class="ph ph-house icon-regular" aria-hidden="true"></i><i class="ph-fill ph-house icon-fill" aria-hidden="true"></i><span data-i18n="nav.home">Home</span></a>
    <a data-dock-route="services" href={`${base}#services`}><i class="ph ph-briefcase icon-regular" aria-hidden="true"></i><i class="ph-fill ph-briefcase icon-fill" aria-hidden="true"></i><span data-i18n="nav.services">Services</span></a>
    <a class="mobile-dock-action" data-dock-route="contact" href={`${base}contact`} aria-label="Start a project" data-i18n-aria-label="nav.start"><i class="ph ph-chat-circle icon-regular" aria-hidden="true"></i><i class="ph-fill ph-chat-circle icon-fill" aria-hidden="true"></i><span data-i18n="nav.mobile.start">Start</span></a>
    <a data-dock-route="work" href={`${base}projects`}><i class="ph ph-grid-four icon-regular" aria-hidden="true"></i><i class="ph-fill ph-grid-four icon-fill" aria-hidden="true"></i><span data-i18n="nav.work">Work</span></a>
    <button class="mobile-dock-more" type="button" aria-expanded="false" aria-controls="more-panel" data-more-toggle><i class="ph ph-dots-three icon-regular" aria-hidden="true"></i><i class="ph-fill ph-dots-three icon-fill" aria-hidden="true"></i><span data-i18n="nav.mobile.more">More</span></button>
  </nav>
  <button class="more-backdrop" type="button" aria-label="Close more menu" data-more-backdrop hidden></button>
  <aside id="more-panel" class="more-panel" data-more-panel aria-label="More links" hidden>
    <span class="more-panel-handle" aria-hidden="true"></span>
    <nav class="more-panel-links" aria-label="More navigation">
      <a href={`${base}about`} data-i18n="nav.more.about">About us</a>
    </nav>
  </aside>
</header>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const moreToggle = document.querySelector<HTMLButtonElement>('[data-more-toggle]');
  const nav = document.querySelector('[data-nav]');
  const morePanel = document.querySelector<HTMLElement>('[data-more-panel]');
  const moreBackdrop = document.querySelector<HTMLButtonElement>('[data-more-backdrop]');
  let moreOpenTimer: number | undefined;
  let moreCloseTimer: number | undefined;
  const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
  const homeHref = document.querySelector<HTMLAnchorElement>('[data-dock-route="home"]')?.href;
  const rootPath = homeHref ? new URL(homeHref).pathname.replace(/\/$/, '') || '/' : '/';
  const projectsPath = rootPath === '/' ? '/projects' : `${rootPath}/projects`;
  const contactPath = rootPath === '/' ? '/contact' : `${rootPath}/contact`;
  const updateDockState = () => {
    const isServices = currentPath === rootPath && window.location.hash === '#services';
    document.querySelectorAll<HTMLElement>('[data-dock-route]').forEach((item) => {
      const route = item.dataset.dockRoute;
      const isHome = route === 'home' && currentPath === rootPath && !isServices;
      const isWork = route === 'work' && (currentPath === projectsPath || currentPath.startsWith(`${projectsPath}/`));
      const isContact = route === 'contact' && currentPath === contactPath;
      const isActive = isHome || (route === 'services' && isServices) || isWork || isContact;
      item.classList.toggle('is-active', isActive);
      if (isActive) item.setAttribute('aria-current', 'page');
      else item.removeAttribute('aria-current');
    });
  };
  updateDockState();
  window.addEventListener('hashchange', updateDockState);
  const closeMenu = () => {
    menuToggle?.setAttribute('aria-expanded', 'false');
    nav?.removeAttribute('data-open');
    document.body.removeAttribute('data-menu-open');
    if (menuToggle) menuToggle.querySelector('.menu-label')!.textContent = document.documentElement.lang === 'ar' ? 'القائمة' : 'Menu';
  };
  const closeMore = () => {
    moreToggle?.setAttribute('aria-expanded', 'false');
    moreToggle?.classList.remove('is-active');
    morePanel?.classList.remove('is-open');
    moreBackdrop?.classList.remove('is-open');
    document.body.removeAttribute('data-more-open');
    if (moreOpenTimer) window.clearTimeout(moreOpenTimer);
    if (moreCloseTimer) window.clearTimeout(moreCloseTimer);
    moreCloseTimer = window.setTimeout(() => {
      morePanel?.setAttribute('hidden', '');
      moreBackdrop?.setAttribute('hidden', '');
    }, 220);
  };
  menuToggle?.addEventListener('click', () => {
    const open = menuToggle.getAttribute('aria-expanded') === 'true';
    if (open) closeMenu();
    else {
      closeMore();
      menuToggle.setAttribute('aria-expanded', 'true');
      nav?.setAttribute('data-open', '');
      document.body.setAttribute('data-menu-open', '');
      menuToggle.querySelector('.menu-label')!.textContent = document.documentElement.lang === 'ar' ? 'إغلاق' : 'Close';
    }
  });
  moreToggle?.addEventListener('click', () => {
    const open = moreToggle.getAttribute('aria-expanded') === 'true';
    if (open) closeMore();
    else {
      closeMenu();
      moreToggle.setAttribute('aria-expanded', 'true');
      moreToggle.classList.add('is-active');
      if (moreOpenTimer) window.clearTimeout(moreOpenTimer);
      if (moreCloseTimer) window.clearTimeout(moreCloseTimer);
      morePanel?.removeAttribute('hidden');
      moreBackdrop?.removeAttribute('hidden');
      document.body.setAttribute('data-more-open', '');
      moreOpenTimer = window.setTimeout(() => {
        morePanel?.classList.add('is-open');
        moreBackdrop?.classList.add('is-open');
      }, 16);
    }
  });
  moreBackdrop?.addEventListener('click', closeMore);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu();
      closeMore();
    }
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  morePanel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMore));
  document.addEventListener('localechange', () => {
    const open = menuToggle?.getAttribute('aria-expanded') === 'true';
    if (menuToggle) menuToggle.querySelector('.menu-label')!.textContent = open ? (document.documentElement.lang === 'ar' ? 'إغلاق' : 'Close') : (document.documentElement.lang === 'ar' ? 'القائمة' : 'Menu');
  });
</script>
