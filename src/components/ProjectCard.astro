---
interface Props {
  title: string;
  category: string;
  year: string;
  image: string;
  slug: string;
  index: number;
}
const { title, category, year, image, slug, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<a class="project-card" href={`${base}projects/${slug}`}>
  <div class="project-image-wrap">
    <img src={image} alt={title} loading={index > 1 ? 'lazy' : 'eager'} />
    <span class="project-arrow" aria-hidden="true">↗</span>
  </div>
  <div class="project-meta">
    <div>
      <h3>{title}</h3>
      <p>{category}</p>
    </div>
    <span>{year}</span>
  </div>
</a>
