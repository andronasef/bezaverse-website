---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Start a conversation">
  <section class="page-hero section-dark contact-hero">
    <p class="eyebrow" data-reveal>Get in Touch</p>
    <h1 data-reveal>Let’s talk about<br /><em>your project.</em></h1>
    <p class="hero-lede" data-reveal>Tell us what you’re building. We design and build high-quality digital products globally.</p>
  </section>
  <section class="section contact-section">
    <div class="contact-details" data-reveal>
      <p class="eyebrow">Prefer a direct line?</p>
      <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
      <p>{site.location}</p>
      <p>{site.phone}</p>
    </div>
    <form class="contact-form" data-contact-form data-reveal>
      <label>Name<input name="name" required autocomplete="name" placeholder="Your name" /></label>
      <label>Email<input name="email" type="email" required autocomplete="email" placeholder="you@company.com" /></label>
      <label>What are you working on?<textarea name="message" required rows="5" placeholder="A little context helps us prepare."></textarea></label>
      <button class="button" type="submit">Send enquiry <span aria-hidden="true">↗</span></button>
      <p class="form-status" role="status" aria-live="polite" data-form-status></p>
    </form>
  </section>
  <script>
    const form = document.querySelector('[data-contact-form]');
    const status = document.querySelector('[data-form-status]');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement) || !form.checkValidity()) {
        status.textContent = 'Please check the highlighted fields and try again.';
        return;
      }
      status.textContent = 'Thanks. Your note is ready to send, and we’ll be in touch shortly.';
      form.reset();
    });
  </script>
</BaseLayout>
