---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/ui/hero-1.astro';
import { faqs, services } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const assetUrl = (path: string) => path.startsWith('/') ? `${base}${path.slice(1)}` : path;
const projects = await getCollection('projects');
const featured = ['pcabins', 'fajr', 'ama-investors', 'tharaa']
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project): project is (typeof projects)[number] => Boolean(project));
---

<BaseLayout title="Digital work that moves businesses forward" titleKey="home.hero.title" descriptionKey="home.hero.subtitle">
  <Hero
    title="Digital work that moves businesses forward."
    subtitle="We design and build websites, online stores, and digital products that make ambitious businesses clearer, more useful, and ready for what comes next."
    eyebrow="Bezaverse · Technical studio"
    ctaLabel="Start a project"
    ctaHref={`${base}contact`}
    eyebrowKey="home.hero.eyebrow"
    titleKey="home.hero.title"
    subtitleKey="home.hero.subtitle"
    ctaLabelKey="home.hero.cta"
  />

  {false && <section class="home-hero section-dark">
    <div class="shell home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow">Bezaverse · Technical studio</p>
        <h1>Digital work that moves <em>businesses forward.</em></h1>
        <p class="hero-lede">We design and build websites, online stores, and digital products that make ambitious businesses clearer, more useful, and ready for what comes next.</p>
        <div class="hero-actions"><a class="button button-light" href={`${base}contact`}>Start a project <span aria-hidden="true">↗</span></a><a class="text-link text-link-light" href={`${base}projects`}>See selected work <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="home-hero-art">
        <div class="hero-art-orbit" aria-hidden="true"></div>
        <div class="hero-art-core">
          <div class="hero-art-brand"><img src={`${base}assets/brand/bezaverse-letter.svg`} alt="" /><span>Bezaverse</span></div>
          <p>Digital studio</p>
          <strong>Strategy<br />Design<br />Build</strong>
          <div class="hero-art-rule" aria-hidden="true"></div>
          <small>Websites / Stores / Products</small>
        </div>
      </div>
    </div>
    <div class="shell home-hero-foot"><span>Design · Development · Direction</span><span>For the next useful thing.</span></div>
  </section>}

  <section id="services" class="services-showcase section-paper">
    <div class="shell services-showcase-intro">
      <div class="services-showcase-title">
        </span><span data-i18n="home.services.badge">Services</span></p>
        <h2 data-i18n-html="home.services.title">We design and build better digital products, <em>all in one place.</em></h2>
      </div>
      <div class="services-showcase-copy">
        <p data-i18n="home.services.copy">From a sharper website to a complete digital product, we bring direction, design, and development together around what your business needs next.</p>
        <a class="button button-outline-light" href={`${base}projects`}>See selected work <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="services-rail" aria-label="Bezaverse services">
      <div class="services-track">
      {services.map((service) => <article class="service-card">
        <img src={assetUrl(service.image)} alt={service.title} data-i18n-alt={`service.${service.number}.title`} loading="lazy" />
        <div class="service-card-shade" aria-hidden="true"></div>
        <div class="service-card-content">
          <div class="service-card-tags">{service.tags.map((tag, tagIndex) => <span data-i18n={`service.${service.number}.tag.${tagIndex}`}>{tag}</span>)}</div>
          <h3 data-i18n={`service.${service.number}.title`}>{service.title}</h3>
          <p data-i18n={`service.${service.number}.text`}>{service.text}</p>
        </div>
        <span class="service-card-arrow" aria-hidden="true">↗</span>
      </article>)}
      {services.map((service) => <article class="service-card" aria-hidden="true">
        <img src={assetUrl(service.image)} alt="" data-i18n-alt={`service.${service.number}.title`} loading="lazy" />
        <div class="service-card-shade" aria-hidden="true"></div>
        <div class="service-card-content">
          <div class="service-card-tags">{service.tags.map((tag, tagIndex) => <span data-i18n={`service.${service.number}.tag.${tagIndex}`}>{tag}</span>)}</div>
          <h3 data-i18n={`service.${service.number}.title`}>{service.title}</h3>
          <p data-i18n={`service.${service.number}.text`}>{service.text}</p>
        </div>
        <span class="service-card-arrow" aria-hidden="true">↗</span>
      </article>)}
      </div>
    </div>
  </section>

  {false && <section id="services-legacy" class="services-legacy section-paper">
    <div class="shell">
      <div class="section-heading-row">
        <div><p class="eyebrow">What we do</p><h2>From the first idea<br />to the <em>useful thing.</em></h2></div>
        <p>Different businesses need different digital answers. We bring strategy, design, and development together around the problem worth solving.</p>
      </div>
      <div class="service-list">
        {services.map((service) => <article class="service-row"><span>{service.number}</span><h3>{service.title}</h3><p>{service.text}</p><span class="service-arrow" aria-hidden="true">↗</span></article>)}
      </div>
    </div>
  </section>}

  <section class="studio-note section-lime">
    <div class="shell studio-note-grid">
      <p class="eyebrow" data-i18n="home.approach.eyebrow">The Bezaverse approach</p>
      <h2 data-i18n-html="home.approach.title">Good digital work should feel <em>clear.</em></h2>
      <p data-i18n="home.approach.copy">We care about the thinking behind the interface: what people need, what the business is trying to change, and how the final experience behaves in the real world.</p>
    </div>
  </section>

  <section class="featured-work section-dark">
    <div class="shell">
      <div class="section-heading-row">
        <div><p class="eyebrow" data-i18n="home.work.eyebrow">Selected work</p><h2 data-i18n-html="home.work.title">Built for the<br /><em>context.</em></h2></div>
        <a class="text-link text-link-light" href={`${base}projects`}>View all work <span aria-hidden="true">↗</span></a>
      </div>
      <div class="featured-work-grid">
        {featured.map((project, index) => <a class:list={['featured-card', index % 3 === 1 && 'featured-card-offset']} href={`${base}projects/${project.slug}`}>
          <div class="featured-card-image"><img src={assetUrl(project.data.image)} alt={project.data.title} loading="lazy" /><span aria-hidden="true">↗</span></div>
          <p>{project.data.category} · {project.data.platform}</p><h3>{project.data.title}</h3>
        </a>)}
      </div>
    </div>
  </section>

  <section class="process-section section-paper">
    <div class="shell">
      <div class="section-heading-row"><div><p class="eyebrow" data-i18n="home.process.eyebrow">How we work</p><h2 data-i18n-html="home.process.title">A clear path<br />through <em>complexity.</em></h2></div><p data-i18n="home.process.copy">We keep the process visible, collaborative, and grounded in the decisions that make the work better.</p></div>
      <div class="process-grid">
        <article><span>01</span><h3 data-i18n="home.process.understand">Understand</h3><p data-i18n="home.process.understand.copy">We learn the business, audience, opportunity, and constraints before we start making noise.</p></article>
        <article><span>02</span><h3 data-i18n="home.process.shape">Shape</h3><p data-i18n="home.process.shape.copy">We turn the problem into a clear structure, a useful journey, and a direction people can align around.</p></article>
        <article><span>03</span><h3 data-i18n="home.process.build">Build</h3><p data-i18n="home.process.build.copy">We design and develop the experience with care for the details that make it work in production.</p></article>
        <article><span>04</span><h3 data-i18n="home.process.improve">Improve</h3><p data-i18n="home.process.improve.copy">We leave room for learning, iteration, and the next useful improvement after launch.</p></article>
      </div>
    </div>
  </section>

  <section class="faq-section section-paper">
    <div class="shell faq-layout">
      <div><p class="eyebrow" data-i18n="home.faq.eyebrow">A few useful answers</p><h2 data-i18n-html="home.faq.title">Before we<br /><em>begin.</em></h2><p class="faq-intro" data-i18n="home.faq.copy">Every project is different, but the way we start should always feel straightforward.</p></div>
      <div class="faq-list">
        {faqs.map((faq, index) => <details open={index === 0}><summary><span>0{index + 1}</span><span data-i18n={`home.faq.${index + 1}.question`}>{faq.question}</span><b aria-hidden="true">+</b></summary><p data-i18n={`home.faq.${index + 1}.answer`}>{faq.answer}</p></details>)}
      </div>
    </div>
  </section>

  {false && <section class="home-cta section-dark">
    <div class="shell home-cta-inner"><p class="eyebrow">Have a direction in mind?</p><h2>Let’s make it<br /><em>real and useful.</em></h2><a class="button button-light" href={`${base}contact`}>Start a conversation <span aria-hidden="true">↗</span></a></div>
  </section>}
</BaseLayout>
